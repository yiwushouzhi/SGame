; 地球上最后的孩子：灾墟树屋 —— 垂直切片原型
; Godot 4.4+ / 2D 俯视角 ARPG
config_version=5

[application]

config/name="灾墟树屋：垂直切片"
config/description="《地球上最后的孩子：灾墟树屋》2D 俯视角 ARPG 原型"
run/main_scene="res://scenes/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.039, 0.055, 1)
boot_splash/show_image=false

[autoload]

GameManager="*res://autoloads/GameManager.gd"
DayNightManager="*res://autoloads/DayNightManager.gd"
InventoryManager="*res://autoloads/InventoryManager.gd"
CraftManager="*res://autoloads/CraftManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/SmileySans.otf"
theme/default_font_size=20

